# Week 6 Day 4: every secret docker compose needs — NAMES only, never values.
# Copy this file to .env (which git ignores) and fill in your own values.

# Any strong password; only the API container ever uses it.
POSTGRES_PASSWORD=

# At least 32 random bytes, base64-encoded. In PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=

# The password every seeded demo account gets (admin, counsellor, learner).
SEED_USERS_PASSWORD=
